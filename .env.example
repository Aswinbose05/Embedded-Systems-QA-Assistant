# =========================================================
# Embedded Systems QA Assistant - Environment Configuration
# =========================================================

# Groq LLM API Configuration (Required)
GROQ_API_KEY=your_groq_api_key_here

# LLM Gateway Model Routing (Configurable)
PRIMARY_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=openai/gpt-oss-20b

# LangSmith Observability & Tracing (Optional)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=embedded-systems-qa
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# HuggingFace Embeddings (Optional - only needed for gated models)
HUGGINGFACE_API_KEY=

# ChromaDB Configuration
CHROMA_DIRECTORY=./chroma_db
COLLECTION_NAME=academic_qa
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
